        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki"
          },
          "expr": "{container_name=~\"coreai_worker|coreai_mcp\"} |= \"$task_id\"",
