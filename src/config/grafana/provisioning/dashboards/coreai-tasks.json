          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS task_id, payload->>'task_type' AS tipo, created_at, round(EXTRACT(EPOCH FROM (now() - created_at))::numeric / 3600, 1) AS edad_h, payload->>'error_trace' AS error_trace FROM tasks WHERE status = 'FAILED' ORDER BY created_at DESC",
