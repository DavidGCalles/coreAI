          "rawSql": "SELECT id AS task_id, payload->>'task_type' AS tipo, status AS estado, round(EXTRACT(EPOCH FROM (updated_at - created_at))::numeric, 1) AS dur_s, payload->>'error_trace' AS error, created_at FROM tasks WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 200",
