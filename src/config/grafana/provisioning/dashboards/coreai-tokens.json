    {
      "id": 5,
      "type": "stat",
      "title": "Gasto externo (fallback)",
      "description": "Local-first = 0 €. Cualquier valor distinto de 0 significa que el fallback a API externa se activó. Nota: litellm_spend_metric_total está en USD.",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justify": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
