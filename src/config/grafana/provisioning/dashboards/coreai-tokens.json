    {
      "id": 10,
      "type": "stat",
      "title": "Embeddings (Infinity) · requests",
      "description": "Verificado 21 Oct 2026: Infinity NO expone métricas de tokens, así que cuenta requests a /embeddings vía http_requests_total (prometheus-fastapi-instrumentator). Si el panel queda vacío, ejecuta http_requests_total en Explore, mira el label job real y ajusta el regex job=~\".*infinity.*\". Para tokens reales de embeddings, enrutarlas vía LiteLLM.",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justify": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
