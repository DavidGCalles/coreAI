    {
      "id": 12,
      "type": "stat",
      "title": "Ahorro estimado (rango)",
      "description": "Tokens procesados local × precio externo (variables precio_input / precio_output, €/1M, definidas en el JSON). Defaults ≈ Gemini 3.8 Flash en € (tarifa que sube el 1 enero 2027). Ojo: el gasto litellm_spend está en USD y los precios en € — es una celebración, no un dato auditable 😄",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "currencyEUR", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "yellow" } },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justify": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS}" },
          "editorMode": "code",
          "expr": "(sum(increase(litellm_input_tokens_metric_total[$__range])) / 1e6 * ${precio_input}) + (sum(increase(litellm_output_tokens_metric_total[$__range])) / 1e6 * ${precio_output}) - sum(increase(litellm_spend_metric_total[$__range]))",
          "legendFormat": "ahorro",
          "range": false,
          "refId": "A"
        }
      ]
    },
