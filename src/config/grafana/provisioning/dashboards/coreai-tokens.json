          "datasource": { "type": "prometheus", "uid": "${DS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/embeddings\", job=~\".*infinity.*\"}[$__rate_interval])))",
