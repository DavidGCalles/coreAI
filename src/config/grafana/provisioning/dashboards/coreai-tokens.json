      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS}" },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{handler=\"/embeddings\", job=~\".*infinity.*\"}[$__rate_interval])) * 60",
          "legendFormat": "requests/min",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS}" },
          "editorMode": "code",
          "expr": "sum(rate(http_request_size_bytes_sum{handler=\"/embeddings\", job=~\".*infinity.*\"}[$__rate_interval])) * 60 / 4",
          "legendFormat": "~tokens/min (est.)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Infinity · p95 latencia /embeddings",
      "description": "histogram_quantile sobre http_request_duration_seconds_bucket (handler /embeddings). La latencia de indexado de memoria unificada.",
      "datasource": { "type": "prometheus", "uid": "${DS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "p95 (s)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
