# ==========================================
# PERSISTENCIA (Postgres)
# ==========================================
POSTGRES_USER=coreai_user
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=coreai_db
# URL +ConfigManager
POSTGRES_URL=postgresql+asyncpg://coreai_user:postgres_secure_password@postgres:5432/coreai_db

# ==========================================
# RUTAS INTERNAS (Servicios Docker)
# ==========================================
QDRANT_URL=http://qdrant:6333
LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=sk-coreai-internal

# ==========================================
# LLM / EMBEDDINGS (Para LiteLLM Config)
# ==========================================
# Apunta al servicio interno de embeddings (Infinity)
EMBEDDING_API_BASE=http://infinity:8080
# Apunta a tu servidor LLM local físico (ej. LM Studio/Ollama)
LOCAL_LLM_API_BASE=http://192.168.1.37:1234/v1

# ==========================================
# APLICACIÓN MCP
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO

# ==========================================
# ENTIDADES DECLARATIVAS (ADR-012-001 #112)
# ==========================================
# Solo la RUTA del fichero YAML va por env — el contenido de entidades jamás
# (D2 del ADR-012). Montado por el compose desde ./data/entities/ (ejemplo de
# referencia: src/config/entities.example.yaml). Ausente o vacío = arranque
# normal con solo system_default; malformado = error de arranque determinista.
ENTITIES_FILE=/app/entities/entities.yaml

# ==========================================
# REINTENTOS DE TAREAS (Issue 4.4 — Retries y DLQ)
# ==========================================
# Reintentos de una tarea antes de FAILED (la DLQ lógica del 4.4)
TASK_MAX_RETRIES=3
# Backoff exponencial entre reintentos: base en segundos, techo en segundos y jitter (0.0-1.0)
TASK_BACKOFF_BASE=1.0
TASK_BACKOFF_CAP=30.0
TASK_BACKOFF_JITTER=0.1
